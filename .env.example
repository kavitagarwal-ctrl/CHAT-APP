# Neon dashboard → your project → Connect → copy the pooled connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
# Generate with: openssl rand -base64 32 (must be at least 32 characters)
SESSION_SECRET=replace-this-with-a-long-random-secret-string
# Optional: set a shared invite code if you want to gate account creation
# JOIN_CODE=your-private-invite-code
